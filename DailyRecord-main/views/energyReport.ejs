<%- include('partials/header.ejs') %>

<div class="container mt-4">
  <h3>Báo cáo điện năng tiêu thụ</h3>

  <form method="get" action="/energy/report" class="row g-3 mb-3">
    <div class="col-md-3">
      <label>Từ ngày</label>
      <input type="date" name="fromDate" class="form-control" value="<%= fromDate || '' %>">
    </div>
    <div class="col-md-3">
      <label>Đến ngày</label>
      <input type="date" name="toDate" class="form-control" value="<%= toDate || '' %>">
    </div>
    <div class="col-md-3">
      <label>Nhóm theo</label>
      <select name="groupBy" class="form-control">
        <option value="day" <%= groupBy==='day'?'selected':'' %>>Ngày</option>
        <option value="week" <%= groupBy==='week'?'selected':'' %>>Tuần</option>
        <option value="month" <%= groupBy==='month'?'selected':'' %>>Tháng</option>
      </select>
    </div>
    <div class="col-md-2 d-flex align-items-end">
      <button type="submit" class="btn btn-primary w-100">Lọc</button>
    </div>
  </form>

  <% if (Object.keys(grouped).length > 0) { %>
    <table class="table table-bordered table-striped">
      <thead>
        <tr>
          <th>Ngày/Tuần/Tháng</th>
          <% const machines = Object.keys(Object.values(grouped)[0]); %>
          <% machines.forEach(m => { %>
            <th><%= m %> (kWh)</th>
          <% }) %>
        </tr>
      </thead>
      <tbody>
        <% Object.keys(grouped).forEach(key => { %>
          <tr>
            <td><%= key %></td>
            <% machines.forEach(m => { %>
              <td><%= grouped[key][m] || 0 %></td>
            <% }) %>
          </tr>
        <% }) %>
      </tbody>
    </table>
  <% } else { %>
    <p class="text-muted">Chưa có dữ liệu trong khoảng thời gian này.</p>
  <% } %>

  <!-- Biểu đồ -->
  <canvas id="energyChart" style="height:400px;"></canvas>
</div>

<%- include('partials/footer.ejs') %>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
  const labels = <%- JSON.stringify(Object.keys(grouped || {})) %>;
  const machines = <%- JSON.stringify(Object.keys(Object.values(grouped || {})[0] || {})) %>;


  const datasets = machines.map((m, i) => ({
    label: m,
    data: labels.map(l => grouped[l][m] || 0),
    borderColor: `hsl(${i*30},70%,50%)`,
    backgroundColor: `hsla(${i*30},70%,50%,0.3)`,
    fill: false
  }));

  const ctx = document.getElementById('energyChart').getContext('2d');
  new Chart(ctx, {
    type: 'line',
    data: { labels, datasets },
    options: {
      responsive: true,
      interaction: { mode: 'index', intersect: false },
      plugins: { legend: { position: 'top' } },
      scales: {
        y: { beginAtZero: true, title: { display: true, text: 'kWh' } }
      }
    }
  });
</script>
